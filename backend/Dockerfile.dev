FROM golang:1.27-alpine

WORKDIR /app

# Hot-reload during development. Pinned: `@latest` re-resolves on every build,
# so two builds of the same commit could ship different binaries.
RUN go install github.com/air-verse/air@v1.67.4

# Cache module downloads (no external deps yet, but ready for future use)
COPY go.mod go.sum* ./
RUN go mod download

# Source is mounted in via docker-compose for live reload
COPY . .

EXPOSE 8080

CMD ["air"]
