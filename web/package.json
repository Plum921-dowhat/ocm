{
  "name": "ocm-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/check-table-widths.mjs && node scripts/check-ai-markdown.mjs",
    "gen:types": "swagger2openapi ../backend/docs/swagger.json -o .openapi.json && openapi-typescript .openapi.json -o src/types/api.d.ts"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "antd": "^6.6.6",
    "dayjs": "^1.11.23",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.102.0",
    "swagger2openapi": "^7.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "nanoid": ">=3.3.17 <4"
  }
}
