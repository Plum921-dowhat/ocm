/* ── 页面基础 ── */
.page {
  display: flex;
  flex-direction: column;
  /* 原生导航栏 + 原生 tabBar 都在页面视口之外，100vh 已扣掉两者 */
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* ── 滚动区 ── */
.scroll-content {
  flex: 1;
  /* flex 子项默认 min-height:auto,内容高会撑破固定高容器,须显式清零 */
  min-height: 0;
  box-sizing: border-box;
}

/* ── 用户卡片 ── */
.user-section {
  padding: var(--space-md);
  background: #FFFFFF;
}

.user-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  background: #FFFFFF;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
}

.user-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
}

.user-role {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 14rpx;
  background: var(--color-primary-light);
  border-radius: 20rpx;
}

.user-role text {
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--color-primary);
}

.user-org {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.card-arrow {
  width: 16rpx;
  height: 16rpx;
  border: solid var(--color-text-secondary);
  border-width: 2rpx 2rpx 0 0;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ── 数据概览 ── */
.stats-section {
  padding: 0 var(--space-md) var(--space-md);
  background: #FFFFFF;
}

.stats-card {
  display: flex;
  flex-direction: row;
  padding: var(--space-md) 0;
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  position: relative;
}

.stats-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 48rpx;
  background: var(--color-border);
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.stats-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* ── 菜单分组 ── */
.menu-section {
  padding: var(--space-sm) var(--space-md);
  background: var(--color-bg);
}

.menu-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md);
}

.menu-divider {
  border-bottom: 1rpx solid var(--color-border);
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.menu-name {
  flex: 1;
  font-size: var(--font-md);
  color: var(--color-text);
  min-width: 0;
}

.menu-extra {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.menu-arrow {
  width: 14rpx;
  height: 14rpx;
  border: solid var(--color-text-tertiary);
  border-width: 2rpx 2rpx 0 0;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ── 退出登录 ── */
.logout-section {
  padding: var(--space-md);
  background: var(--color-bg);
}

.logout-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  height: 96rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.logout-icon {
  width: 40rpx;
  height: 40rpx;
}

.logout-text {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-secondary);
}
