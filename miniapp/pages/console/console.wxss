.page {
  display: flex;
  flex-direction: column;
  /* 原生导航栏 + 原生 tabBar 都在页面视口之外，100vh 已扣掉两者 */
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

.scroll-content {
  flex: 1;
  /* flex 子项默认 min-height:auto,内容高会撑破固定高容器,须显式清零 */
  min-height: 0;
  /* 原生 tabBar 已在视口外;底部留 16px 与页面节奏一致 */
  padding-bottom: var(--space-md);
  box-sizing: border-box;
}

.section {
  padding: var(--space-md) var(--space-md) 0;
}

.section-title {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.section-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.grid-container {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 33.33%;
  padding: 28rpx 0;
  box-sizing: border-box;
}

.grid-icon {
  width: 56rpx;
  height: 56rpx;
}

.grid-label {
  font-size: var(--font-xs);
  color: var(--color-text);
}
